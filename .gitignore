# Device backups, firmware dumps and Yandex binaries: device-specific / proprietary, never publish.
/backup/
/dump/
# Reverse-engineering workspace (Ghidra projects, decompiler output of proprietary code).
/re/
# Upstream reference checkouts (ESPHome linux-voice-assistant, Sendspin).
/ref/

# Build outputs and fetched dependencies.
/satellite/build/
/satellite/target/
/satellite/third_party/src/
/ssh/out/
# The glibc sidecar payload for old-libc ports (satellite/deploy/glibc/fetch.py regenerates it).
/satellite/deploy/glibc/out/
/installer/dist/
# adb downloaded by pulsar-install when it runs from a checkout.
/platform-tools/
# CMake's compiler probe through zig may leave a file named "-".
/satellite/-

# Test recordings / synthesized speech.
*.wav
# ...but the Irbis A earcons are part of the deploy payload (generated, original tones).
!/satellite/deploy/irbis/sounds/*.wav
